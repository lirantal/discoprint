{
  "name": "discoprint",
  "version": "0.2.6",
  "type": "module",
  "description": "Classify an artist's discography by theme, mood, and lyrical complexity with Jev (TypeSafe AI), and view it as a colorful terminal dashboard.",
  "types": "dist/main.d.mts",
  "bin": {
    "discoprint": "./dist/bin/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      },
      "default": "./dist/main.mjs"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "src",
    ".env.schema"
  ],
  "scripts": {
    "start": "tsx src/bin/cli.ts",
    "classify": "tsx src/bin/cli.ts",
    "visualize": "tsx src/bin/cli.ts visualize",
    "build": "tsc && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm run lint:markdown",
    "lint:fix": "eslint . --fix",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml -i '.git' -i 'node_modules' -i 'dist' -i 'coverage' -i 'apm_modules' '**/*.md'",
    "lint:markdown:fix": "pnpm run lint:markdown -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "mkdir -p coverage && tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/bin/cli.ts\" --test-coverage-exclude=\"src/main.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/*.test.ts'",
    "prepare": "husky",
    "version": "changeset version",
    "release": "changeset publish",
    "release:create": "changeset && git add .changeset && git commit -m \"chore: release\" && git push origin HEAD --no-verify"
  },
  "author": {
    "name": "Liran Tal",
    "email": "liran.tal@gmail.com",
    "url": "git+https://github.com/lirantal"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "cli",
    "music",
    "lyrics",
    "ai",
    "discography",
    "mood",
    "classification",
    "jev",
    "typesafe"
  ],
  "homepage": "https://github.com/lirantal/discoprint",
  "bugs": {
    "url": "https://github.com/lirantal/discoprint/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lirantal/discoprint.git"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@varlock/1password-plugin": "^2.0.4",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "varlock": "^1.20.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.2.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.0.11",
    "ink": "^7.1.1",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "^3.3.0",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.0",
    "validate-conventional-commit": "^2.0.0"
  },
  "lint-staged": {
    "**/*.{js,ts,json}": [
      "eslint --fix"
    ]
  }
}
