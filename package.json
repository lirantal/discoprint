{
  "name": "artist-lyrics-classifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Classify an artist's full discography by theme, mood and complexity using Jev (TypeSafe AI).",
  "scripts": {
    "classify": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "test:coverage": "mkdir -p coverage && tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/index.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@varlock/1password-plugin": "^2.0.4",
    "varlock": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
