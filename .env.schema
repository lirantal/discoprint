# Schema for this project's env vars — safe to commit, contains no secrets.
# Real values (including 1Password references) go in a local, gitignored `.env`.
# See https://varlock.dev for the full @env-spec syntax.
#
# This file ships with the npm package (see package.json's `files`), so
# TYPESAFE_API_KEY gets the same @optional/@sensitive handling whether you're
# working in a clone of this repo or ran `npx discoprint` — see
# src/env-loader.ts for how it's loaded either way. The 1Password plugin
# below needs @varlock/1password-plugin resolvable from wherever you're
# running discoprint from, which is only guaranteed inside a clone of this
# repo (it's a real dependency here, but a global/npx install has no reason
# to have it in its own node_modules) — see the op() note on TYPESAFE_API_KEY.

# The version must be pinned here (unlike the plugin's own docs example):
# without it, resolving "@varlock/1password-plugin" outside of a proper
# project context (e.g. a bare `npx --package=varlock ...` invocation, and
# apparently also discoprint's own installed-package context) fails with
# "Plugin ... unable to resolve - set a fixed version" — a root-level schema
# error, not a per-key one, so it silently blocks every value in this file
# rather than just TYPESAFE_API_KEY. Bump this alongside the dependency in
# package.json.
# @plugin(@varlock/1password-plugin@2.0.4)
# Uses OP_SERVICE_ACCOUNT_TOKEN when set (headless: containers, CI) and falls
# back to the 1Password desktop app otherwise (local dev, no token needed).
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true)
# ---

# Only needed for headless auth; picked up automatically if already exported
# in your shell/container — no need to put it in .env.
# @type=opServiceAccountToken @sensitive @internal
OP_SERVICE_ACCOUNT_TOKEN=

# API key for https://console.typesafe.ai (Jev).
# In your local .env, set either a literal key or a 1Password reference, e.g.:
#   TYPESAFE_API_KEY=op(op://Personal/typesafe/api_key)
# The op() form only resolves where @varlock/1password-plugin is actually
# installed (a repo clone) — elsewhere it fails and falls through exactly
# like an unset key does: the interactive prompt below, or a literal value.
# Marked optional (not required): left unset, the CLI prompts for it
# interactively instead (see src/bin/cli.ts), or fails with a clear error in
# non-interactive use.
# @optional @sensitive @type=string
TYPESAFE_API_KEY=
